# ============ Python 学习路线助手 · 环境变量模板 ============
# 使用方法：复制本文件为 .env，然后按需填写。
# 注意：.env 包含你的 API Key，已被 .gitignore 排除，绝不会提交到 GitHub。

# 默认使用哪个 Provider（deepseek/openai/anthropic/moonshot/dashscope/xai/gemini/zhipu/volcengine/local）
LLM_PROVIDER=deepseek

# ---------- DeepSeek（推荐：便宜、中文好） ----------
# 在售型号：deepseek-flash（快省，日常学习路线足够） / deepseek-v4-pro（旗舰）
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-flash

# ---------- OpenAI（GPT 系列） ----------
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-6.1-sol

# ---------- Anthropic（Claude 系列，原生 Messages 协议） ----------
# 注意：Anthropic 不是 OpenAI 兼容端点，代码内部已按原生协议分流，
# 与其它 Provider 一样只需填 Key + 选模型即可。
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-sonnet-5-5

# ---------- Kimi（月之暗面，部分模型支持联网） ----------
# 注意：moonshot-v1-8k 等旧型号已下线，请使用 kimi-k3
MOONSHOT_API_KEY=
# MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
# MOONSHOT_MODEL=kimi-k3

# ---------- 通义千问（阿里云百炼） ----------
# 在售型号：qwen3.8-max（旗舰）/ qwen3.7-plus / qwen3.8-flash（快省）
DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_MODEL=qwen3.8-max

# ---------- Grok（xAI） ----------
# 在售型号：grok-4.7（500K 上下文）/ grok-4.6 / grok-4.5
XAI_API_KEY=
# XAI_BASE_URL=https://api.x.ai/v1
# XAI_MODEL=grok-4.7

# ---------- Gemini（Google，走官方 OpenAI 兼容层） ----------
# 在售型号：gemini-3.8-flash / gemini-4-argon（旗舰）/ gemini-3.6-flash
GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# GEMINI_MODEL=gemini-3.8-flash

# ---------- 智谱 GLM（支持联网搜索的模型可替代搜索 Key） ----------
# 在售型号：glm-5.3-flash（低成本）/ glm-5.3（旗舰）
ZHIPU_API_KEY=
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# ZHIPU_MODEL=glm-5.3-flash

# ---------- 豆包方舟（火山引擎） ----------
# 在售型号：doubao-seed-2.1-pro（旗舰）/ doubao-seed-2.1-lite
VOLC_API_KEY=
# VOLC_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/
# VOLC_MODEL=doubao-seed-2.1-pro

# ---------- 本地模型（llama.cpp / Ollama，无需 Key） ----------
# 注意：Qwen3.8 的 chat template 依赖 llama.cpp 的 --jinja 参数，不加会输出乱码。
# 模型名填 llama-server 实际加载的 GGUF 名（如 qwen3.8-27b-q4_k_m.gguf）。
# LOCAL_BASE_URL=http://127.0.0.1:8080/v1
# LOCAL_MODEL=qwen3.8-27b

# ---------- 搜索（二选一即可；都不配则自动降级为纯 LLM 生成） ----------
TAVILY_API_KEY=
SERPAPI_API_KEY=

# ---------- 调试开关（默认关闭，平时不要打开） ----------
# GET /api/search 会直接消耗搜索 API 配额，所以默认根本不注册这个端点（返回 404）。
# 只有本地排查搜索链路时，才临时取消下面这行的注释。
# DEBUG_ENDPOINTS=1

# ============ Python 学习路线助手 · 环境变量模板 ============
# 使用方法：复制本文件为 .env，然后按需填写。
# 注意：.env 包含你的 API Key，已被 .gitignore 排除，绝不会提交到 GitHub。

# 默认使用哪个 Provider（deepseek/openai/anthropic/moonshot/dashscope/zhipu/volcengine/local）
LLM_PROVIDER=deepseek

# ---------- DeepSeek（推荐：便宜、中文好） ----------
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat

# ---------- OpenAI（GPT 系列） ----------
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# ---------- Anthropic（Claude 系列） ----------
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# ---------- Kimi（月之暗面，部分模型支持联网） ----------
MOONSHOT_API_KEY=
# MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
# MOONSHOT_MODEL=moonshot-v1-8k

# ---------- 通义千问（阿里云百炼） ----------
DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_MODEL=qwen-plus

# ---------- 智谱 GLM（支持联网搜索的模型可替代搜索 Key） ----------
ZHIPU_API_KEY=
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# ZHIPU_MODEL=glm-4-flash

# ---------- 豆包方舟（火山引擎） ----------
VOLC_API_KEY=
# VOLC_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/
# VOLC_MODEL=doubao-1-5-pro-32k-250115

# ---------- 本地模型（llama.cpp / Ollama，无需 Key） ----------
# LOCAL_BASE_URL=http://127.0.0.1:8080/v1
# LOCAL_MODEL=qwen3-8b

# ---------- 搜索（二选一即可；都不配则自动降级为纯 LLM 生成） ----------
TAVILY_API_KEY=
SERPAPI_API_KEY=
